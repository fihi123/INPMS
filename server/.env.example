# 로컬 개발용 환경변수 예시. 실제 운영은 App Runner Secrets Manager 주입.

# 운영(PostgreSQL) — I&S 제공 ARN 이 App Runner 에서 이 변수로 주입됨
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/inpms

# 로컬 개발(SQLite) — 별도 설치 불필요
DATABASE_URL=sqlite+pysqlite:///./dev.db

# 개발 중 별도 포트 프론트엔드 사용 시
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
